{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "langgraph-diagnostic-agent/app.ts",
    "diagnostic-agent/app.ts"
  ],
  "exclude": [
    "chess",
    "node_modules"
  ]
}
